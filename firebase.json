{
  "hosting": {
    "site": "restroforyou",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      
         {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/orders",
      "destination": "/orders.html"
    },
    {
      "source": "/share-otp-verify",
      "destination": "/share-otp-verify.html"
    }, 
      
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
